{
  "name": "wish-granted",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Interactive interview that helps people discover grants and assistance programs they may be eligible for. Fully client-side; no answers ever leave the browser.",
  "scripts": {
    "dev": "vite",
    "build": "npm run build:snapshot:check && tsc -b && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc -b --noEmit",
    "typecheck:build-snapshot": "tsc -p scripts/build-snapshot/tsconfig.json --noEmit",
    "data:check": "vitest run tests/data",
    "build:snapshot": "node scripts/build-snapshot/index.ts",
    "build:snapshot:check": "node scripts/build-snapshot/index.ts --check",
    "build:snapshot:measure": "node scripts/build-snapshot/index.ts --measure",
    "test:e2e": "playwright test",
    "test:e2e:prod": "playwright test --config=playwright.prod.config.ts",
    "test:all": "vitest run && playwright test",
    "refresh:income-tables": "node --use-system-ca scripts/refresh-income-tables/index.ts",
    "test:refresh-income-tables": "node --test scripts/refresh-income-tables/lib/__tests__/*.test.ts",
    "typecheck:refresh-income-tables": "tsc -p scripts/refresh-income-tables/tsconfig.json --noEmit",
    "extract:income-tables": "node scripts/extract-income-tables.mjs",
    "eval:llm-extraction": "node --env-file-if-exists=.env scripts/llm-extraction/run-eval.ts",
    "typecheck:llm-extraction": "tsc -p scripts/llm-extraction --noEmit",
    "check:links": "node scripts/check-links.mjs"
  },
  "dependencies": {
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@playwright/test": "^1.62.1",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.5",
    "@types/node": "^26.2.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^4.3.4",
    "jsdom": "^30.0.1",
    "typescript": "~5.7.2",
    "vite": "^6.0.5",
    "vitest": "^3.2.7"
  }
}
