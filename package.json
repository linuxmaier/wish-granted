{
  "name": "wish-granted",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Interactive interview that helps people discover grants and assistance programs they may be eligible for. Fully client-side; no answers ever leave the browser.",
  "scripts": {
    "dev": "vite",
    "build": "npm run build:snapshot:check && tsc -b && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc -b --noEmit",
    "typecheck:build-snapshot": "tsc -p scripts/build-snapshot/tsconfig.json --noEmit",
    "data:check": "vitest run tests/data",
    "build:snapshot": "node scripts/build-snapshot/index.ts",
    "build:snapshot:check": "node scripts/build-snapshot/index.ts --check",
    "build:snapshot:measure": "node scripts/build-snapshot/index.ts --measure",
    "test:e2e": "playwright test",
    "test:e2e:prod": "playwright test --config=playwright.prod.config.ts",
    "test:all": "vitest run && playwright test",
    "refresh:income-tables": "node --use-system-ca scripts/refresh-income-tables/index.ts",
    "refresh:income-tables:self-test": "node scripts/refresh-income-tables/index.ts --self-test",
    "test:refresh-income-tables": "node --test scripts/refresh-income-tables/lib/__tests__/*.test.ts",
    "typecheck:refresh-income-tables": "tsc -p scripts/refresh-income-tables/tsconfig.json --noEmit",
    "extract:income-tables": "node scripts/extract-income-tables.mjs",
    "extract:tier3": "node scripts/tier3-extract/index.mjs",
    "extract:tier3:self-test": "node scripts/tier3-extract/index.mjs --self-test",
    "eval:llm-extraction": "node --env-file-if-exists=.env scripts/llm-extraction/run-eval.ts",
    "typecheck:llm-extraction": "tsc -p scripts/llm-extraction --noEmit",
    "eval:program-extraction": "node --env-file-if-exists=.env --import ./scripts/program-benchmark/register.mjs scripts/program-benchmark/index.ts",
    "eval:program-extraction:self-test": "node --import ./scripts/program-benchmark/register.mjs scripts/program-benchmark/index.ts --self-test",
    "test:program-benchmark": "node --test \"scripts/program-benchmark/lib/__tests__/*.test.ts\"",
    "typecheck:program-benchmark": "tsc -p scripts/program-benchmark/tsconfig.json --noEmit",
    "extract:agentic": "node --env-file-if-exists=.env --import ./scripts/agentic-extract/register.mjs scripts/agentic-extract/index.ts",
    "extract:agentic:self-test": "node --import ./scripts/agentic-extract/register.mjs scripts/agentic-extract/index.ts --self-test",
    "test:agentic-extract": "node --test \"scripts/agentic-extract/lib/__tests__/*.test.ts\"",
    "typecheck:agentic-extract": "tsc -p scripts/agentic-extract/tsconfig.json --noEmit",
    "extract:cross-check": "node --env-file-if-exists=.env --import ./scripts/cross-check/register.mjs scripts/cross-check/index.ts",
    "extract:cross-check:self-test": "node --import ./scripts/cross-check/register.mjs scripts/cross-check/index.ts --self-test",
    "test:cross-check": "node --test \"scripts/cross-check/lib/__tests__/*.test.ts\"",
    "typecheck:cross-check": "tsc -p scripts/cross-check/tsconfig.json --noEmit",
    "check:links": "node scripts/check-links.mjs",
    "check:sources": "node --use-system-ca --import ./scripts/check-sources/register.mjs scripts/check-sources/index.ts",
    "check:sources:self-test": "node --import ./scripts/check-sources/register.mjs scripts/check-sources/index.ts --self-test",
    "test:check-sources": "node --test scripts/check-sources/lib/__tests__/*.test.ts",
    "typecheck:check-sources": "tsc -p scripts/check-sources/tsconfig.json --noEmit",
    "ingest:descriptive": "node --use-system-ca --import ./scripts/ingest-descriptive/register.mjs scripts/ingest-descriptive/index.ts",
    "ingest:descriptive:self-test": "node --import ./scripts/ingest-descriptive/register.mjs scripts/ingest-descriptive/index.ts --self-test",
    "test:ingest-descriptive": "node --test scripts/ingest-descriptive/lib/__tests__/*.test.ts",
    "typecheck:ingest-descriptive": "tsc -p scripts/ingest-descriptive/tsconfig.json --noEmit",
    "render-fallback:self-test": "node scripts/render-fallback/index.ts --self-test",
    "render-fallback:browser-check": "node scripts/render-fallback/index.ts --browser-check",
    "test:render-fallback": "node --test \"scripts/render-fallback/lib/__tests__/*.test.ts\"",
    "typecheck:render-fallback": "tsc -p scripts/render-fallback/tsconfig.json --noEmit"
  },
  "dependencies": {
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@playwright/test": "^1.62.1",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.5",
    "@types/node": "^26.2.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^4.3.4",
    "jsdom": "^30.0.1",
    "typescript": "~5.7.2",
    "vite": "^6.0.5",
    "vitest": "^3.2.7"
  }
}
