{
  "name": "wish-granted",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Interactive interview that helps people discover grants and assistance programs they may be eligible for. Fully client-side; no answers ever leave the browser.",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc -b --noEmit",
    "data:check": "vitest run tests/data",
    "test:e2e": "playwright test",
    "test:all": "vitest run && playwright test",
    "extract:income-tables": "node scripts/extract-income-tables.mjs",
    "eval:llm-extraction": "node --experimental-strip-types scripts/llm-extraction/run-eval.ts"
  },
  "dependencies": {
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.1",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.5",
    "@types/node": "^26.2.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^4.3.4",
    "jsdom": "^30.0.1",
    "typescript": "~5.7.2",
    "vite": "^6.0.5",
    "vitest": "^3.2.7"
  }
}
