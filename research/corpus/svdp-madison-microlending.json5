    "categories": ["small-business"],
    // A consumer debt-consolidation loan program, not a business one -- but "small-business" is the only CATEGORY touching lending/finance. Another instance of the category-set gap.
    "summary": "Small-dollar loans ($400-$2,500) at 4-8% interest over two years, through local banks, to help Dane County residents consolidate or pay off high-interest payday and auto-title loans. Includes financial education.",
    "benefit": "A $400-$2,500 loan at 4-8% with flexible repayment over two years, plus financial coaching. Not for rent, deposits, utilities, medical bills, or vehicles.",
    "howToApply": {
      "url": "https://svdpmadison.org/program/microlending/",
      "phone": "608-257-0919",
      "steps": [
        "Confirm you meet the requirements (Dane County, income at or below 300% FPL, willing to open a bank account, debt-to-income under 47%).",
        "Complete the Microloan Candidate Interest Form; a representative responds within five business days.",
        "Candidates meeting preliminary criteria are invited to continue the application with a local bank."
      ]
    },
    "status": "open",
    "seasonalNote": null
  },

  "rule": {
    "eligibility": {
      "kind": "allOf",
      "of": [
        // "You must live in Dane County,"
        { "kind": "compare", "fact": "county", "op": "eq", "value": "dane" },
        // "have a regular monthly household income at or below 300% of the federal poverty level (FPL),"
        { "kind": "incomeAtOrBelow", "scale": "fpl", "percent": 300 },
        // "be willing to have a bank account, and"
        { "kind": "compare", "fact": "willingToOpenBankAccount", "op": "eq", "value": true },
        // "your monthly debt-to-income ratio must be under 47%."
        { "kind": "compare", "fact": "debtToIncomeRatioUnder47", "op": "eq", "value": true },
        { "kind": "manualReview", "note": "Purpose test: the loan must consolidate or pay off a high-interest (37%+) payday or auto-title loan, or consolidate multiple debts into one payment. Explicitly not for monthly bills, rent, deposits, mortgage, medical expenses, or vehicle costs." }
      ]
    },
    "factsNeeded": [
      { "key": "willingToOpenBankAccount", "type": "boolean", "sourceText": "be willing to have a bank account" },
      { "key": "debtToIncomeRatioUnder47", "type": "boolean", "sourceText": "your monthly debt-to-income ratio must be under 47% -- (housing costs + monthly debt repayments) / gross monthly income. A computed financial ratio, not a single figure a person readily knows" }
    ],
    "expressibility": {
      "level": "partial",
      "note": "Residency + income + willingness map cleanly. The DTI-under-47% test is a computed ratio the person is unlikely to know offhand; the loan-purpose test (must be paying off a 37%+ loan or consolidating debt) is a manualReview judgment on the applicant's situation."
    },
    "branchDropRisk": [],
