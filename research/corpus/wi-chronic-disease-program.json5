  "record": {
    "name": "Wisconsin Chronic Disease Program",
    "administeredBy": "Wisconsin Department of Health Services (ForwardHealth)",
    "jurisdiction": "state",
    "provider": "government",
    "categories": ["health-disability"],
    "summary": "State-funded help paying for care and supplies for Wisconsin residents with one of three conditions: chronic (end-stage) renal disease, hemophilia, or adult cystic fibrosis.",
    "benefit": "Coverage of condition-specific services and supplies (dialysis/transplant care, blood products and infusion supplies, CF medicines and services). Members pay copays and deductibles; those over 300% FPL pay an income-based deductible first.",
    "howToApply": {
      "url": "https://www.dhs.wisconsin.gov/forwardhealth/wcdp.htm",
      "phone": null,
      "steps": [
        "Get diagnosed and referred by the appropriate specialty center (a renal program, a hemophilia treatment center, or a cystic fibrosis center).",
        "Submit the program-specific application (F-01186 renal, F-01184 hemophilia, F-01185 adult CF) with a Financial Need Statement.",
        "Submit a new Financial Need Statement every year to keep benefits."
      ]
    },
    "requiredDocuments": ["Program application", "Financial Need Statement (F-01189 / F-01187 / F-01188)", "Residency verification (F-01143 / F-01145 / F-01144)"],
    "status": "open",
    "seasonalNote": null
  },

  "rule": {
    /*
      There is NO income ceiling. "300% of the federal poverty level" is a
      deductible trigger, not an eligibility gate: "If you make more than 300% of
      the federal poverty level each year, you must pay a certain amount yourself
      before getting benefits." Same shape as SeniorCare (seniorcare-wi) -- a
      prominent FPL percentage that reads as a ceiling but is a cost-share tier.
      This is one file (not three) because it is one benefit with a three-way
      anyOf over qualifying conditions -- the GO-NO-GO.md §6.6 "stays one file"
      case.
    */
    "eligibility": {
      "kind": "allOf",
      "of": [
        // "If the applicant is not a Wisconsin resident or does not intend to remain a resident of Wisconsin, the application will be denied."
        { "kind": "compare", "fact": "state", "op": "eq", "value": "WI" },
        {
          // "WCDP helps people get services and supplies that treat: Adult cystic fibrosis / Hemophilia / Renal Disease"
          "kind": "anyOf",
          "of": [
            { "kind": "allOf", "of": [
              { "kind": "compare", "fact": "hasEndStageRenalDisease", "op": "eq", "value": true },
              { "kind": "manualReview", "note": "Renal members who can get Medicare must pay Medicare Part B premiums to receive benefits; those who can get Medicare but don't are ineligible until they start paying premiums." }
            ]},
            { "kind": "allOf", "of": [
              // "A hemophilia treatment center must have diagnosed them."
              { "kind": "compare", "fact": "hasHemophilia", "op": "eq", "value": true },
              // "They also must have agreed in writing to enter a treatment program through the center."
              { "kind": "compare", "fact": "agreedToHemophiliaTreatmentProgram", "op": "eq", "value": true }
            ]},
            { "kind": "allOf", "of": [
              { "kind": "compare", "fact": "hasCysticFibrosis", "op": "eq", "value": true },
              /* "Members must be 18 years or older" -- but our age bands start at "under-60", which includes minors. The 18 floor is not expressible. */
              { "kind": "set", "fact": "age", "op": "in", "values": ["60-64", "65-plus", "under-60"] }
            ]}
          ]
        }
      ]
    },
    "factsNeeded": [
      { "key": "hasEndStageRenalDisease", "type": "boolean", "sourceText": "The Chronic Renal Disease Program helps people with advanced renal disease." },
      { "key": "hasHemophilia", "type": "boolean", "sourceText": "The Hemophilia Home Care Program helps people with hemophilia. A hemophilia treatment center must have diagnosed them." },
      { "key": "hasCysticFibrosis", "type": "boolean", "sourceText": "The Adult Cystic Fibrosis Program helps adults with cystic fibrosis." },
      { "key": "agreedToHemophiliaTreatmentProgram", "type": "boolean", "sourceText": "must have agreed in writing to enter a treatment program through the center" },
      { "key": "diagnosedBySpecialtyCenter", "type": "boolean", "sourceText": "The medical director of a cystic fibrosis center must have diagnosed them / A hemophilia treatment center must have diagnosed them -- not just 'has the condition' but 'diagnosed by a specific type of accredited center'" }
    ],
    "expressibility": {
      "level": "partial",
      "note": "The condition disjunction and residency map cleanly (given new condition facts). The diagnosis-by-accredited-center requirement, the annual Financial Need Statement, and the renal Medicare Part B condition are all manualReview. The 18+ floor for adult CF cannot be expressed with AGE_BANDS."
    },
    "branchDropRisk": [
      {
        "figure": "300% of the federal poverty level",
        "takenNaivelyAs": "an income ceiling for the program",
        "actuallyIs": "a deductible trigger -- above 300% FPL you pay an income-based deductible before benefits, but you are still eligible. No income bound.",
        "direction": "narrower"
      }
    ],
    "unencodable": [
      { "kind": "professional-assessment", "text": "The diagnosis itself, and the requirement that it come from a specific accredited center type." },
      { "kind": "documentation", "text": "The annual Financial Need Statement -- 'a member is not eligible for benefits until this completed statement is on file'." },
      { "kind": "other", "text": "Renal: the Medicare Part B premium condition (must enroll and pay premiums if Medicare-eligible)." },
      { "kind": "other", "text": "The 18+ floor for the adult CF program (age bands cannot express it)." },
      { "kind": "other", "text": "Estate Recovery: 'The state gets paid for benefits it provides through the Wisconsin Estate Recovery Program' -- a lien-style recovery, relevant context but not an eligibility test." },
      { "kind": "incorporated-law", "text": "Full statutory eligibility is in ss. 49.68 / 49.683 / 49.685 / 49.686, Wis. Stats., not fetched here." }
    ]
  },

