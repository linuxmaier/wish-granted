    "provider": "government",
    "categories": ["food-basic-needs"],
    "summary": "Vouchers for older adults with limited income to buy fresh, locally grown produce at Wisconsin farmers markets and farmstands.",
    "benefit": "Five $5.00 checks ($25.00 total) per person per growing season (June 1 through October 31) for fresh fruits, vegetables, and herbs grown in or near Wisconsin.",
    "howToApply": {
      "url": "https://www.dhs.wisconsin.gov/wic/fmnp/senior.htm",
      "phone": null,
      "steps": [
        "Contact your local agency -- usually your county's Aging and Disability Resource Center (ADRC).",
        "Complete the SFMNP Eligibility Agreement (form F-40103), self-certifying age, residency, and income.",
        "Receive your checks and a list of participating markets and farmstands."
      ]
    },
    "status": "seasonal",
    "seasonalNote": "Checks are valid June 1 through October 31. Enrollment opens seasonally through local agencies; supplies are limited."
  },

  "rule": {
    "eligibility": {
      "kind": "allOf",
      "of": [
        // "Live in Wisconsin. / I certify that I am a resident of ____ county."
        { "kind": "compare", "fact": "state", "op": "eq", "value": "WI" },
        {
          // "Be age 60 or greater. Native Americans can join at age 55 or greater."
          "kind": "anyOf",
          "of": [
            { "kind": "set", "fact": "age", "op": "in", "values": ["60-64", "65-plus"] },
            { "kind": "allOf", "of": [
              { "kind": "compare", "fact": "isNativeAmerican", "op": "eq", "value": true },
              /* 55 is inside our "under-60" band; not expressible with AGE_BANDS. */
              { "kind": "compare", "fact": "ageAtLeast55", "op": "eq", "value": true }
            ]}
          ]
        },
        // form F-40103: "I certify that my household income is at or below 185 percent of the federal poverty guideline." The citizen web page says only "Meet income guidelines" with NO number.
        { "kind": "incomeAtOrBelow", "scale": "fpl", "percent": 185 }
      ]
    },
    "factsNeeded": [
      { "key": "isNativeAmerican", "type": "boolean", "sourceText": "Native Americans can join at age 55 or greater" },
      { "key": "ageAtLeast55", "type": "boolean", "sourceText": "age 55 or greater -- AGE_BANDS cannot express a 55 cut point" }
