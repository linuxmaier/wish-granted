    "provider": "government",
    "categories": ["veterans", "health-disability"],
    "summary": "A monthly payment to low-income wartime veterans who are 65 or older or have a permanent and total disability, and whose income and net worth are within federal limits.",
    "benefit": "A monthly pension bringing countable income up to a Congressionally set Maximum Annual Pension Rate (MAPR). Add-ons for Aid and Attendance or Housebound status (see us-va-aid-attendance).",
    "howToApply": {
      "url": "https://www.va.gov/pension/how-to-apply/",
      "phone": "800-827-1000",
      "steps": [
        "Complete VA Form 21P-527EZ (online, by mail, or with help from an accredited representative or a County Veterans Service Officer).",
        "Provide income, net worth, and medical evidence.",
        "VA determines countable income and pays the difference up to the MAPR."
      ]
    },
    "status": "open",
    "seasonalNote": null
  },

  "rule": {
    "eligibility": {
      "kind": "allOf",
      "of": [
        { "kind": "compare", "fact": "isVeteran", "op": "eq", "value": true },
        // "You didn't receive a dishonorable discharge"
        { "kind": "not", "of": { "kind": "compare", "fact": "dischargeWasDishonorable", "op": "eq", "value": true } },
        // "Your yearly family income and net worth meet certain limits set by Congress." -- net worth includes spouse's; excludes house, car, most furnishings.
        { "kind": "compare", "fact": "vaPensionIncomeAndNetWorthWithinLimit", "op": "eq", "value": true },
        {
          /* "at least 1 of these must be true about your service:" -- service-length/era rules keyed to when active duty began (pre-9/8/1980: 90 days incl. 1 wartime day; enlisted after 9/7/1980: 24 months...). */
          "kind": "compare", "fact": "vaPensionWartimeServiceRequirementMet", "op": "eq", "value": true
        },
        {
          // "And at least 1 of these must be true:"
          "kind": "anyOf",
          "of": [
            { "kind": "set", "fact": "age", "op": "in", "values": ["65-plus"] },
            { "kind": "compare", "fact": "hasPermanentAndTotalDisability", "op": "eq", "value": true },
            { "kind": "compare", "fact": "isNursingHomePatientForDisability", "op": "eq", "value": true },
            // "or You're getting Social Security Disability Insurance or Supplemental Security Income" -- SSDI is not in BENEFIT_ENROLLMENTS
            { "kind": "set", "fact": "currentBenefits", "op": "includesAny", "values": ["ssi"] }
          ]
        }
      ]
    },
    "factsNeeded": [
      { "key": "isVeteran", "type": "boolean", "sourceText": "wartime Veterans (RESERVED today)" },
      { "key": "dischargeWasDishonorable", "type": "boolean", "sourceText": "You didn't receive a dishonorable discharge" },
      { "key": "vaPensionIncomeAndNetWorthWithinLimit", "type": "boolean", "sourceText": "yearly family income and net worth meet certain limits set by Congress -- a combined income + asset test with specific exclusions (house, car, furnishings); net worth includes the spouse's. Not an FPL-scaled figure." },
      { "key": "vaPensionWartimeServiceRequirementMet", "type": "boolean", "sourceText": "service-length + wartime-day rules keyed to the date active duty began (pre-1980 vs post-1980 enlisted vs post-1981 officer) -- a multi-branch service test folded into one fact" },
      { "key": "hasPermanentAndTotalDisability", "type": "boolean", "sourceText": "You have a permanent and total disability -- distinct from a VA service-connected rating; this is the P&T standard" },
      { "key": "isNursingHomePatientForDisability", "type": "boolean", "sourceText": "You're a patient in a nursing home for long-term care because of a disability" }
