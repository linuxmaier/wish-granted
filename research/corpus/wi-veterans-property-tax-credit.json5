  "record": {
    "name": "Wisconsin Veterans and Surviving Spouses Property Tax Credit",
    "administeredBy": "Wisconsin Department of Revenue (eligibility certified by the Wisconsin Department of Veterans Affairs)",
    "jurisdiction": "state",
    "provider": "government",
    "categories": ["veterans", "housing-utilities"],
    "summary": "A refundable state income-tax credit equal to 100% of the property taxes paid on the primary Wisconsin home (and up to one acre) of a veteran with a 100% service-connected disability rating, or their unremarried surviving spouse.",
    "benefit": "A refundable credit for the full amount of property taxes paid during the year on the principal dwelling. Renters who pay property tax through rent may qualify with proof. There is no income limit.",
    "howToApply": {
      "url": "https://dva.wi.gov/services/housing-and-financial-services/property-tax-credit/",
      "phone": "800-947-8387",
      "steps": [
        "Contact your County or Tribal Veterans Service Office for a WDVA eligibility certification (form / booklet WDVA B0106).",
        "Attach the WDVA certificate to your Wisconsin income tax return the first year you claim the credit.",
        "Claim the credit on your Wisconsin income tax return each year."
      ]
    },
    "requiredDocuments": ["WDVA eligibility verification certificate", "Property tax bill(s) for the primary residence"],
    "status": "open",
    "seasonalNote": null
  },

  "rule": {
    /*
      Two independent routes: eligible veteran, or eligible unremarried surviving
      spouse. Encoding the veteran route; the surviving-spouse route is
      structurally similar with extra death/DIC conditions and is summarised in
      unencodable.
    */
    "eligibility": {
      "kind": "anyOf",
      "of": [
        {
          // "'Eligible veteran' means an individual ... certified by the WDVA as meeting all of the following:"
          "kind": "allOf",
          "of": [
            { "kind": "compare", "fact": "isVeteran", "op": "eq", "value": true },
            // "Served on active duty under honorable conditions in the U.S. Armed Forces or in forces incorporated in the U.S. Armed Forces"
            { "kind": "compare", "fact": "servedActiveDutyHonorable", "op": "eq", "value": true },
            // "Was a resident of Wisconsin at the time of entry into active service or ... for any consecutive 5-year period after entry into that active duty service"
            { "kind": "compare", "fact": "wisconsinResidencyNexusAtEntryOr5Years", "op": "eq", "value": true },
            // "Is currently a resident of Wisconsin for purposes of receiving veterans benefits under ch. 45, Wis. Stats."
            { "kind": "compare", "fact": "state", "op": "eq", "value": "WI" },
            // "Has a service-connected disability rating of 100% under 38 USC 1114 or 1134 or a 100% disability rating based on individual unemployability"
            { "kind": "compare", "fact": "vaDisabilityRating100OrIU", "op": "eq", "value": true },
            // "property taxes paid on ... an eligible veteran's ... principal dwelling; up to one acre of land; not second homes or vacation properties"
            { "kind": "compare", "fact": "ownsAndOccupiesPrimaryResidence", "op": "eq", "value": true }
          ]
        }
      ]
    },
    "factsNeeded": [
      { "key": "isVeteran", "type": "boolean", "sourceText": "an eligible veteran (RESERVED today)" },
      { "key": "servedActiveDutyHonorable", "type": "boolean", "sourceText": "Served on active duty under honorable conditions" },
      { "key": "wisconsinResidencyNexusAtEntryOr5Years", "type": "boolean", "sourceText": "resident of Wisconsin at the time of entry ... or ... any consecutive 5-year period after entry -- a residency-history test, not a current-state test" },
      { "key": "vaDisabilityRating100OrIU", "type": "enum-or-boolean", "sourceText": "a service-connected disability rating of 100% under 38 USC 1114 or 1134 or a 100% disability rating based on individual unemployability -- far more specific than the reserved hasDisability boolean; 'individual unemployability' itself has a multi-part definition (60% rating, or 40%+combined-70%, plus an administrative adjustment to 100%)" },
      { "key": "ownsAndOccupiesPrimaryResidence", "type": "boolean", "sourceText": "principal dwelling ... up to one acre ... not second homes or vacation properties (housingStatus today is renting/own-home/unhoused/living-with-others -- 'own-home' is close but does not capture principal-vs-vacation or the one-acre limit)" }
    ],
    "expressibility": {
      "level": "partial",
      "note": "The veteran route's shape maps to an allOf of six facts. But 'individual unemployability' is compound VA rating arithmetic (manualReview), the WDVA certification is a determination not a self-assertion, and the three surviving-spouse routes are omitted. The reserved hasDisability boolean is almost useless here -- the rule needs a specific 100% rating."
    },
    "branchDropRisk": [
      {
        "figure": "(no income figure anywhere on either page)",
        "takenNaivelyAs": "an omission to be filled -- a reader pattern-matching 'benefit => income threshold' invents an income ceiling",
        "actuallyIs": "This program has NO income test. The eligibility list is otherwise exhaustive; the absence is deliberate. Inventing an income gate would wrongly rule out higher-income disabled veterans the program is explicitly for.",
        "direction": "looser"
      }
    ],
    "unencodable": [
      { "kind": "documentation", "text": "The WDVA certification step itself -- eligibility is a determination the WDVA makes and stamps, not something the taxpayer self-asserts." },
      { "kind": "incorporated-law", "text": "The 'individual unemployability' sub-definition (compound VA rating arithmetic: 60% single, or 40%+combined-70%, plus an administrative adjustment)." },
      { "kind": "other", "text": "The surviving-spouse routes: (a) veteran died on active duty while a WI resident; (b) veteran had a 100%/IU rating and died a WI resident; (c) National Guard/reserve member died in line of duty; (d) spouse receives and continues to receive Dependency and Indemnity Compensation -- each with its own residency conditions." },
      { "kind": "other", "text": "Joint-ownership proration; farm/business-use proration; renters must prove the property-tax portion of rent." }
    ]
