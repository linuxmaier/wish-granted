  "record": {
    "name": "Emergency Assistance (EA)",
    "administeredBy": "Wisconsin Department of Children and Families (a W-2 / TANF-related program); delivered by W-2 agencies",
    "jurisdiction": "state",
    "provider": "government",
    "categories": ["housing-utilities", "food-basic-needs"],
    "summary": "A one-time cash payment for Wisconsin families with a child under 18 who are facing an emergency -- homelessness, impending homelessness, domestic violence, fire, flood, natural disaster, or an energy crisis. It can cover first month's rent, a security deposit, necessary home repairs, essential household items, or utilities.",
    "benefit": "Up to $1,200 for a group of 2-5 people ($220 per person for groups of 6+), or up to $750 for an energy crisis. Available once every 12 months.",
    "howToApply": {
      "url": "https://dcf.wisconsin.gov/ea",
      "phone": "855-757-4539",
      "steps": [
        "Check eligibility anonymously on ACCESS (access.wi.gov), or apply online or in person.",
        "Your local W-2 agency determines eligibility and helps you find local resources.",
        "If approved, you get a payment to help with the emergency."
      ]
    },
    "status": "open",
    "seasonalNote": null
  },

  "rule": {
    "eligibility": {
      "kind": "allOf",
      "of": [
        // "you must be a parent or a relative caring for a child younger than 18"
        {
          "kind": "anyOf",
          "of": [
            { "kind": "compare", "fact": "isParent", "op": "eq", "value": true },
            { "kind": "compare", "fact": "isRelativeCaringForChildUnder18", "op": "eq", "value": true }
          ]
        },
        { "kind": "compare", "fact": "hasChildUnder18InHome", "op": "eq", "value": true },
        // "Your income must be at or below 115% of the Federal Poverty Level"
        { "kind": "incomeAtOrBelow", "scale": "fpl", "percent": 115 },
        // "you must have limited assets ... Your car is only counted as an asset if it is worth more than $10,000."
        { "kind": "compare", "fact": "assetsWithinEALimitExcludingModestCar", "op": "eq", "value": true },
        {
          // "experiencing a current emergency due to fire, flood or natural disaster, impending homelessness, homelessness, domestic violence, or energy crisis"
          "kind": "anyOf",
          "of": [
            { "kind": "compare", "fact": "isExperiencingHomelessness", "op": "eq", "value": true },
            { "kind": "compare", "fact": "facingImpendingHomelessness", "op": "eq", "value": true },
            { "kind": "compare", "fact": "experiencingDomesticViolence", "op": "eq", "value": true },
            { "kind": "compare", "fact": "hadFireFloodOrNaturalDisaster", "op": "eq", "value": true },
            { "kind": "compare", "fact": "hasEnergyCrisis", "op": "eq", "value": true }
          ]
        },
        { "kind": "manualReview", "note": "The emergency must be 'current' and verified, and a Fact Finding Review is the appeal path. DCF 120 sets detailed rules on what counts as impending homelessness, an energy crisis, etc. Once every 12 months." }
      ]
    },
    "factsNeeded": [
      { "key": "isRelativeCaringForChildUnder18", "type": "boolean", "sourceText": "a parent or a relative caring for a child younger than 18" },
      { "key": "hasChildUnder18InHome", "type": "boolean", "sourceText": "a child younger than 18 (shared with wisconsin-works-w2)" },
      { "key": "assetsWithinEALimitExcludingModestCar", "type": "boolean", "sourceText": "limited assets ... Your car is only counted as an asset if it is worth more than $10,000" },
