      "url": "https://svdpmadison.org/program/vinnys-lockers/",
      "phone": "608-205-8276",
      "steps": [
        "Call (608) 257-0919 and leave a message with your contact information.",
        "Facility is at 1312 Culmen Street, Madison, open Wednesdays 2-4pm.",
        "Agree to check in within 60 days of storing items."
      ]
    },
    "status": "waitlist",
    "seasonalNote": null,
    // "Up to 45 people can use this free program" -- fixed capacity, so modelled as waitlist rather than open.
