  "record": {
    "name": "Kinship Care",
    "administeredBy": "Wisconsin Department of Children and Families (administered by county and tribal kinship care agencies)",
    "jurisdiction": "state",
    "provider": "government",
    "categories": ["childcare-education"],
    // Fits "childcare-education" only loosely -- it is a cash payment to a relative raising someone else's child, closer to "food-basic-needs" in purpose. No CATEGORY cleanly covers kinship/foster support.
    "summary": "A monthly payment to a relative (or 'like-kin') who is raising a child that cannot safely live with their parents. Kinship Care has no income test for the caregiver.",
    "benefit": "$384 per month per child (2026 rate, set by state statute). Court-ordered kinship care is paid at a different rate.",
    "howToApply": {
      "url": "https://dcf.wisconsin.gov/kinship",
      "phone": null,
      "steps": [
        "Contact the Kinship Care Coordinator for your county or tribe.",
        "Apply; the agency assesses the three basic eligibility tests and runs background checks on all adults in the home.",
        "Eligibility is reviewed every 12 months."
      ]
    },
    "requiredDocuments": ["Background Information Disclosure form (DCF-F-2978-E) for the caregiver and every adult resident"],
    "status": "open",
    "seasonalNote": null
  },

  "rule": {
    /*
      There is NO caregiver income test -- a deliberate design choice that
      distinguishes Kinship Care from W-2/TANF. An extractor primed by every other
      benefit in this corpus to look for an income threshold will not find one,
      and must resist inventing one. See branchDropRisk.
    */
    "eligibility": {
      "kind": "allOf",
      "of": [
        { "kind": "compare", "fact": "state", "op": "eq", "value": "WI" },
        // "a relative caregiver ... providing care and maintenance for a child; 'Relative' ... except that it does not include a parent. Child = person under 18 (or older if a full-time student ...)."
        { "kind": "compare", "fact": "isRelativeCaregiverOfChildInHome", "op": "eq", "value": true },
        { "kind": "manualReview", "note": "The three basic tests are all agency judgments: (1) the basic needs of the child can be better met with the caregiver than with the parent; (2) the placement is in the best interests of the child; (3) the child currently or might meet the requirements to be in need of protection or services (CHIPS) if left with the parent(s)." },
        { "kind": "manualReview", "note": "Criminal background check on the caregiver and all adult residents; a 'barred offense' is an initial denial, appealable via Director Review (local-agency discretion)." }
      ]
    },
    "factsNeeded": [
      { "key": "isRelativeCaregiverOfChildInHome", "type": "boolean", "sourceText": "a relative caregiver ... providing care and maintenance for a child [who lives with them rather than a parent]; 'Relative' does not include a parent" }
    ],
    "expressibility": {
      "level": "manual-review-dominant",
      "note": "The only decidable leaves are 'in Wisconsin' and 'is a relative caregiver'. All three substantive tests are agency judgments (better-met-with-caregiver, best-interests, CHIPS-likelihood), plus a background check. The encoded rule is mostly manualReview even though it needs only one new fact."
    },
    "branchDropRisk": [
      {
        "figure": "$384 per month (2026 kinship care rate)",
        "takenNaivelyAs": "a benefit that implies an income-tested program, prompting the reader to look for / invent an income ceiling",
        "actuallyIs": "a flat statutory per-child rate. Kinship Care has NO caregiver income test by design. The hazard is hallucinating one from pattern-matching every other benefit in the corpus.",
        "direction": "looser"
      }
    ],
    "unencodable": [
      { "kind": "professional-assessment", "text": "'basic needs of the child can be better met with the caregiver than with the parent' -- agency comparison." },
      { "kind": "professional-assessment", "text": "'the placement is in the best interests of the child' -- agency judgment." },
      { "kind": "professional-assessment", "text": "'the child currently or might meet the requirements to be in need of protection or services' -- a predictive legal standard (CHIPS)." },
      { "kind": "documentation", "text": "Background check outcome, barred-offense list, and Director Review discretion." },
      { "kind": "work-requirement", "text": "Cooperation requirements: caregiver must apply for other benefits the child may be eligible for, and cooperate with child-support referral unless granted a good-cause exemption." },
      { "kind": "incorporated-law", "text": "The child-age definition itself: 'under 18' plus student extensions to 19 and, in specific court-order / IEP cases, 21." }
    ]
  },

