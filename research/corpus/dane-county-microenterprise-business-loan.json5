      { "kind": "agency-discretion", "text": "The required pre-application advising session and the CDBG Commission vote -- the application 'will be on the subsequent CDBG Commission meeting agenda'." },
      { "kind": "other", "text": "Ineligible business types (adult entertainment, gambling/liquor/tobacco, marijuana dispensaries, passive real estate, pyramid structures)." },
      { "kind": "incorporated-law", "text": "The CDBG 'national objective' framework (24 CFR 570) behind the LMI job-creation / LMI-owner requirement." }
    ]
  },

