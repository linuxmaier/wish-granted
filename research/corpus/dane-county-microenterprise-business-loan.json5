  "record": {
    "name": "Dane County Microenterprise Business Loan (MBL) Program",
    "administeredBy": "Dane County Office of Economic & Workforce Development, overseen by the Dane County CDBG Commission; funded by federal CDBG (HUD)",
    "jurisdiction": "county",
    "provider": "government",
    "categories": ["small-business"],
    "summary": "Small loans ($1,500-$8,000) for very small businesses (5 or fewer employees) in Dane County outside the City of Madison, to start a new business or create jobs for low- and moderate-income county residents.",
    "benefit": "A $1,500-$8,000 loan for start-up overhead, licenses, advertising, incorporation, rent, utilities, insurance, equipment, or employee training. Not for operating deficits, debt refinancing, or personal income.",
    "howToApply": {
      "url": "https://cdbg.danecounty.gov/rlf/mbl",
      "phone": "608-267-1540",
      "steps": [
        "Complete a small-business development training program (City of Madison 'Market Ready', WWBIC, UW-Madison SBDC, or an equivalent approved by the CDBG Commission).",
        "Schedule and complete a pre-application advising session with OED staff.",
        "Submit the application; it goes on the CDBG Commission's meeting agenda for a decision."
      ]
    },
    "status": "open",
    "seasonalNote": null
  },

  "rule": {
    "eligibility": {
      "kind": "allOf",
      "of": [
        // "The applicant must be the business owner or entrepreneur."
        { "kind": "compare", "fact": "isBusinessOwnerOrEntrepreneur", "op": "eq", "value": true },
        // "The business must be physically located within Dane County's Urban County Consortium." (Dane County outside the City of Madison)
        { "kind": "compare", "fact": "county", "op": "eq", "value": "dane" },
        { "kind": "not", "of": { "kind": "compare", "fact": "city", "op": "eq", "value": "madison" } },
        // "The business must have five or fewer employees, including the owner."
        { "kind": "compare", "fact": "businessHas5OrFewerEmployees", "op": "eq", "value": true },
        // "established within the last five years or be ready to start within six months"
        { "kind": "compare", "fact": "businessUnder5YearsOldOrStartingWithin6Months", "op": "eq", "value": true },
        // "Prior to applying ... applicant must complete a business development training program from one of the following ..."
        { "kind": "compare", "fact": "completedApprovedBusinessTraining", "op": "eq", "value": true },
        {
          /* CDBG national objective: the loan must create jobs for LMI county residents OR the owner is LMI. Stated in the program purpose, not the numbered applicant list. */
          "kind": "anyOf",
          "of": [
            { "kind": "incomeAtOrBelow", "scale": "dane-ami", "percent": 80 },
            { "kind": "compare", "fact": "loanWillCreateJobsForLMIResidents", "op": "eq", "value": true }
          ]
        },
        { "kind": "manualReview", "note": "Ineligible business types: adult entertainment; gambling, liquor, or tobacco stores; marijuana dispensaries; passive real estate investments; pyramid structures. Plus a required pre-application advising session and a CDBG Commission vote -- discretionary." }
      ]
    },
    "factsNeeded": [
      { "key": "isBusinessOwnerOrEntrepreneur", "type": "boolean", "sourceText": "The applicant must be the business owner or entrepreneur" },
      { "key": "businessHas5OrFewerEmployees", "type": "boolean", "sourceText": "five or fewer employees, including the owner" },
      { "key": "businessUnder5YearsOldOrStartingWithin6Months", "type": "boolean", "sourceText": "established within the last five years or be ready to start within six months" },
      { "key": "completedApprovedBusinessTraining", "type": "boolean", "sourceText": "must complete a business development training program from one of the following organizations [City of Madison Market Ready / WWBIC / SBDC / approved equivalent]" },
      { "key": "loanWillCreateJobsForLMIResidents", "type": "boolean", "sourceText": "creating jobs for low- and moderate-income (LMI) County residents -- the CDBG national objective; alternative to the owner being LMI" }
    ],
    "expressibility": {
      "level": "partial",
      "note": "Most conditions map (owner, geography, size, age, training completed). The CDBG LMI objective is a two-route branch (owner is LMI OR jobs for LMI residents). The ineligible-business-type list and the Commission vote are manualReview."
