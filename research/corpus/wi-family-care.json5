  "rule": {
    "eligibility": {
      "kind": "allOf",
      "of": [
        // "Be at least 18 years old."
        { "kind": "compare", "fact": "isAdult", "op": "eq", "value": true },
        // "Be a frail elder or an adult with a disability."
