        { "kind": "compare", "fact": "hasLongTermCareConditionOver90Days", "op": "eq", "value": true },
        // "Be functionally eligible. The Long-Term Care Functional Screen helps confirm eligibility."
        { "kind": "manualReview", "note": "The Wisconsin Long-Term Care Functional Screen. Same instrument as IRIS and the ADRC long-term-care route. 'People with dementia and a terminal condition also may qualify' -- an additional route decided by the screen." }
