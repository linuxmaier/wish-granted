      "url": "https://www.dhs.wisconsin.gov/birthto3/family/eligibility.htm",
      "phone": "800-642-7837",
      "steps": [
        "Contact your county Birth to 3 Program (a referral from anyone -- parent, doctor, WIC -- starts it).",
        "A team including you, a service coordinator, and child-development professionals evaluates your child.",
        "If eligible, the team writes an Individualized Family Service Plan."
      ]
    },
    "status": "open",
    "seasonalNote": null
