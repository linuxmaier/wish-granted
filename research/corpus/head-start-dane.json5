  "record": {
    "name": "Head Start and Early Head Start (Dane County - Reach Dane)",
    "administeredBy": "Reach Dane (federal Head Start grantee for Dane and Green counties); program rules set by the U.S. Administration for Children and Families",
    "jurisdiction": "federal",
    "provider": "nonprofit",
    "categories": ["childcare-education"],
    "summary": "Free early education, health, and family support for pregnant women and children under 6 in low-income families. Early Head Start serves pregnant women and children under 3; Head Start serves children 3 to 5.",
    "benefit": "Center-based or home-based early education, meals and diapers for enrolled children, health and developmental screening, disability services, dual-language support, and family case management. No cost to the family.",
    "howToApply": {
      "url": "https://www.reachdane.org/enroll/",
      "phone": "608-275-6740",
      "steps": [
        "Complete the application online or on paper (return by mail, email, fax, or in person).",
        "Submit income verification (last two pay stubs, or SSI benefit letter; none needed if homeless).",
        "For in-person full-day programming, a child care subsidy is also required."
      ]
    },
    "requiredDocuments": ["Income verification (pay stubs or SSI benefit letter)", "Child's age verification (a program cannot require documents if it creates an enrollment barrier)", "Child care subsidy confirmation (full-day in-person programs only)"],
    "status": "waitlist",
    "seasonalNote": null,
    // 45 CFR 1302.12(d)(2)(vii) presumes waiting lists exist. Reach Dane accepts applications year-round; slots are limited.
  },

  "rule": {
    /*
      The "100% of the poverty line" figure is one of four alternative qualifying
      routes in 45 CFR 1302.12(c)(1), NOT the rule. On top of that: (c)(2) lets a
      program fill up to 10% of enrollment with over-income children who "would
      benefit from services"; (d)(1) lets a program enroll another 35% with
      incomes below 130% of poverty; (e) lets Tribal programs enroll regardless
      of income; (f) makes Migrant/Seasonal families eligible via agricultural
      employment. See branchDropRisk -- the headstart-cfr-over-income-allowance
      case from docs/pipeline-principles.md §3.1.
    */
    "eligibility": {
      "kind": "allOf",
      "of": [
        {
          // 45 CFR 1302.12(b) Age requirements
          "kind": "anyOf",
          "of": [
            // Early Head Start also serves pregnant women.
            { "kind": "compare", "fact": "isPregnantOrPostpartum", "op": "eq", "value": true },
            // "Early Head Start: infant/toddler younger than three. Head Start Preschool: at least three and no older than the age required to attend school."
            { "kind": "compare", "fact": "hasChildUnder6", "op": "eq", "value": true }
          ]
        },
        {
          /*
            45 CFR 1302.12(c)(1): A pregnant woman or a child is eligible if --
            (i) income at or below the poverty line; or (ii) eligible for /
            potentially eligible for public assistance including TANF child-only;
            or (iii) the child is homeless (part 1305 definition); or (iv) the
            child is in foster care.
          */
          "kind": "anyOf",
          "of": [
            { "kind": "incomeAtOrBelow", "scale": "fpl", "percent": 100 },
            /* "eligible for or potentially eligible for public assistance" is broader than "currently receiving" -- our currentBenefits fact only captures current receipt. */
            { "kind": "set", "fact": "currentBenefits", "op": "includesAny", "values": ["w2-tanf", "ssi"] },
            { "kind": "compare", "fact": "childIsHomeless", "op": "eq", "value": true },
            { "kind": "compare", "fact": "childInFosterCare", "op": "eq", "value": true }
          ]
        }
      ]
    },
    "factsNeeded": [
      { "key": "hasChildUnder6", "type": "boolean", "sourceText": "birth to compulsory school age -- our facts are hasChildUnder5 and hasSchoolAgeChild; the boundary the rule uses ('age required to attend school') is community-specific" },
      { "key": "childIsHomeless", "type": "boolean", "sourceText": "The child is homeless, as defined in part 1305 (the McKinney-Vento definition -- includes doubled-up/shared housing due to loss of housing, not only literal homelessness)" },
      { "key": "childInFosterCare", "type": "boolean", "sourceText": "The child is in foster care." },
      { "key": "potentiallyEligibleForPublicAssistance", "type": "boolean", "sourceText": "The family is eligible for or, in the absence of child care, would be potentially eligible for public assistance -- a hypothetical eligibility test, not a current-receipt test" }
    ],
    "expressibility": {
      "level": "partial",
      "note": "The age + four-way qualifying-route core maps cleanly given new child facts. The two over-income allowances (10% 'would benefit'; 35% under 130%) are agency-discretion and cannot be a household-level rule; the 'potentially eligible for public assistance' route is a hypothetical the interview cannot ask."
    },
    "branchDropRisk": [
      {
        "figure": "100% of the poverty line",
        "takenNaivelyAs": "the income ceiling for Head Start eligibility",
        "actuallyIs": "one of four alternative qualifying routes in (c)(1), plus a 10% over-income allowance (c)(2) and a 35%/under-130% allowance (d)(1) in separate subsections. Encoding 100% FPL alone drops the categorical routes AND both allowances.",
        "direction": "narrower"
      },
      {
        "figure": "130% Poverty Level column on the Reach Dane table",
        "takenNaivelyAs": "a second income tier that everyone under 130% qualifies through",
        "actuallyIs": "the (d)(1) allowance -- up to 35% of a program's slots, conditioned on the program's own outreach/enrollment policies and on serving (c)-eligible families first. Not a household entitlement.",
        "direction": "narrower"
      }
    ],
    "unencodable": [
      { "kind": "agency-discretion", "text": "(c)(2): the 10% 'would benefit from services' over-income allowance -- a program-discretion slot, no household-level rule." },
      { "kind": "agency-discretion", "text": "(d)(1): the additional 35% under 130% poverty, gated on the program having outreach/enrollment policies and serving (c)-eligible families first." },
      { "kind": "agency-discretion", "text": "(i)(1)(ii): a program MAY reduce counted income by housing costs exceeding 30% of gross income -- an optional deduction the family cannot rely on. (i)(1)(v): 'significant change in income ... program staff may consider current income'." },
      { "kind": "incorporated-law", "text": "(e) Tribal 'regardless of income'; (f) Migrant/Seasonal agricultural-employment route; (g) small-community (<=1,000 people) local criteria; the part-1305 homeless definition." },
      { "kind": "other", "text": "Reach Dane's full-day programs additionally require a child care subsidy and a working / job-search parent -- a local overlay on the federal rule." }
    ]
  },

