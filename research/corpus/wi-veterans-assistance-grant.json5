  "record": {
    "name": "Wisconsin Veterans Subsistence Aid Grant",
    "administeredBy": "Wisconsin Department of Veterans Affairs (applications through County/Tribal Veterans Service Offices)",
    "jurisdiction": "state",
    "provider": "government",
    "categories": ["veterans"],
    "summary": "A short-term cash grant for Wisconsin veterans (and certain surviving spouses and military families) who have lost income because of illness, injury, or a natural disaster and have exhausted other aid.",
    "benefit": "Grant payments toward essential living expenses (rent/mortgage, food, utilities, medications, essential travel, child care) for up to a 90-day period. Maximum $3,000 in any consecutive 12 months; $7,500 combined lifetime limit with Health Care Aid.",
    "howToApply": {
      "url": "https://dva.wi.gov/services/mental-health-and-emergency-services/subsistence-aid-health-care-aid-grants/",
      "phone": "800-947-8387",
      "steps": [
        "Contact your County or Tribal Veterans Service Office (CVSO/TVSO).",
        "Submit form WDVA 2453 with a 'declaration of aid' from a county/tribal official confirming you applied for all other county/state/federal aid.",
        "Apply within 12 months of the verified loss of income."
      ]
    },
    "requiredDocuments": [
      "Form WDVA 2453 (Assistance to Needy Veterans Grant Application - Subsistence Aid)",
      "Declaration of aid signed by an authorised county/tribal official",
      "List of all household assets and 3 months of household living expenses",
      "Evidence of the loss of income (and, if the loss stems from alcohol/other drug abuse, proof of current participation in an approved treatment program)"
    ],
    "status": "open",
    "seasonalNote": null
  },

  "rule": {
    "eligibility": {
      "kind": "allOf",
      "of": [
        {
          // VA 2.01(2)(b)1.: "The applicant satisfies the requirements of s. 45.01(12), Stats., to be considered a veteran, or is a spouse or dependent of [such an individual]."
          "kind": "anyOf",
          "of": [
            { "kind": "compare", "fact": "isVeteran", "op": "eq", "value": true },
            { "kind": "compare", "fact": "isSpouseOrDependentOfVeteran", "op": "eq", "value": true }
          ]
        },
        // VA 2.01(2)(b)2m.: "The applicant has suffered a loss of income due to illness, injury, or natural disaster."
        { "kind": "compare", "fact": "lostIncomeFromIllnessInjuryOrDisaster", "op": "eq", "value": true },
        // VA 2.01(2)(b)3m.: "the applicant's household income may not exceed 200 percent of the federal poverty guidelines ... (Exception under par. (d) for spouse/dependent of an activated/deployed member: 'federal poverty guidelines do not apply'.)"
        { "kind": "incomeAtOrBelow", "scale": "fpl", "percent": 200 },
        { "kind": "manualReview", "note": "VA 2.01(2)(b)4.: 'The applicant lacks other assets or income to meet basic subsistence needs and is not eligible to receive aid from other sources to meet those needs.' Plus the declaration-of-aid requirement -- exhaustion of all other county/state/federal aid, certified by a county official. Not decidable from interview facts." }
      ]
    },
