      { "key": "lostIncomeFromIllnessInjuryOrDisaster", "type": "boolean", "sourceText": "has suffered a loss of income due to illness, injury, or natural disaster (note: narrower than the existing recentIncomeDrop fact, which does not name a cause)" }
    ],
