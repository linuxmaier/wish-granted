            { "kind": "compare", "fact": "inSubstandardUnsafeHousing", "op": "eq", "value": true },
            { "kind": "compare", "fact": "inTemporaryOrOvercrowdedHousing", "op": "eq", "value": true },
            { "kind": "compare", "fact": "housingCostOver30PercentOfIncome", "op": "eq", "value": true },
            { "kind": "compare", "fact": "housingInaccessible", "op": "eq", "value": true },
            { "kind": "compare", "fact": "inSubsidizedOrTransitionalHousing", "op": "eq", "value": true }
          ]
        },
        { "kind": "manualReview", "note": "Attend an informational meeting (currently full), apply within 6 months, and be SELECTED -- Habitat picks partner families from qualified applicants; qualifying does not guarantee a home. Plus completing homebuyer education and sweat-equity hours." }
