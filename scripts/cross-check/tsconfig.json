{
  // Same rationale as scripts/program-benchmark/tsconfig.json and
  // scripts/agentic-extract/tsconfig.json: index.ts imports `@/data/programs`
  // (via the resolve hook at runtime) and the sibling program-benchmark /
  // agentic-extract / tier3-extract modules, which transitively pull in src/
  // files that use extensionless relative imports, so `moduleResolution` is
  // "bundler" (like the root tsconfig), not NodeNext. Node runs it fine via
  // ./register.mjs. Consumed only by `typecheck:cross-check`.
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "noImplicitOverride": true,
    "noFallthroughCasesInSwitch": true,
    "verbatimModuleSyntax": true,
    "isolatedModules": true,
    "skipLibCheck": true,
    "noEmit": true,
    "allowImportingTsExtensions": true,
    "allowJs": true,
    "checkJs": false,
    "resolveJsonModule": true,
    "types": ["node"],
    "paths": { "@/*": ["../../src/*"] }
  },
  "include": ["**/*.ts"]
}
