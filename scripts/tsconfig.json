{
  "extends": "../tsconfig.json",
  "compilerOptions": {
    // Only scripts/ needs this. It is deliberately NOT on the root
    // tsconfig: `npm run typecheck`'s root `tsc -b` never reaches this
    // directory as a *root* program (see `include` below, which replaces
    // the base config's `include` rather than adding to it) and nothing
    // under src/ or tests/ imports these files, so the root program never
    // has to make a decision about ".ts" specifiers at all. This project's
    // own files use them because scripts/llm-extraction/run-eval.ts is
    // executed directly by `node --experimental-strip-types`, which
    // requires explicit extensions on relative ESM imports -- a Node
    // runtime requirement, unrelated to bundler-resolved app code.
    "allowImportingTsExtensions": true
  },
  "include": ["**/*.ts"]
}
