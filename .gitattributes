# The program snapshot is a generated artifact compared byte-for-byte against
# the generator's output (`npm run build:snapshot -- --check`, and
# tests/data/snapshot.test.ts). Pin it to LF so the check behaves identically on
# a Windows checkout (git's autocrlf would otherwise rewrite it to CRLF on
# checkout, and the LF-writing generator would then report spurious drift).
src/data/programs/snapshot.json text eol=lf

# Same reasoning for the snapshot tooling and its inputs -- keeps the generator,
# its tests, and CI reading the exact same bytes regardless of platform.
src/data/programs/records.ts text eol=lf
src/data/programs/build-snapshot.ts text eol=lf
src/data/programs/snapshot-schema.ts text eol=lf
scripts/build-snapshot/** text eol=lf
tests/data/snapshot.test.ts text eol=lf

# The check-sources / ingest-descriptive baselines are LF-serialized committed
# artifacts whose scheduled workflows open a PR on any `git diff` -- pin them to
# LF so a Windows checkout (autocrlf) does not show spurious CRLF drift (issue #49).
scripts/check-sources/source-hashes.json text eol=lf
scripts/ingest-descriptive/proposals.json text eol=lf

# Shell scripts must be LF or bash fails on the stray carriage returns
# ("$'\r': command not found"). The WorktreeCreate hook (#56) runs through Git
# Bash on Windows, so a CRLF checkout would break agent worktree isolation --
# and it would break at dispatch time, far from anything pointing at line
# endings as the cause.
*.sh text eol=lf
